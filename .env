# ─────────────────────────────────────────────
# APK Builder Bot By Kittu — Environment Variables
# ─────────────────────────────────────────────

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Your Telegram numeric user ID (owner/admin)
# Get it from @userinfobot or @getidsbot
OWNER_ID=123456789

# Support username (without @)
SUPPORT_USERNAME=your_support_username

# ── Telethon Userbot (for sending large APKs >50MB) ──
# Get these from https://my.telegram.org → API development tools
API_ID=0
API_HASH=your_api_hash_here

# ── Optional paths (usually no need to change) ──
DB_PATH=apk_bot.db
SESSION_FILE=userbot_session
